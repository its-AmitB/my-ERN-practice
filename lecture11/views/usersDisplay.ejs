<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
</head>
<body>
  <h1>This is home page</h1>
  <table border="1">
    <tr>
      <th>Row1</th>
      <th>Row2</th>
    </tr>
    <% userData.forEach((u)=>{ %>
      <tr>
      <td><%= u.name %></td>
      <td><%= u.age %></td>
      <td><%= u.email %></td>
      </tr>
    <% }) %>
  </table>
</body>
</html>